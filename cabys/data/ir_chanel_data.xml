<?xml version="1.0" encoding="utf-8"?>
<odoo> 
    <data noupdate="0">

        <record model="mail.channel" id="channel_cabys_all_employees">
            <field name="name">Actualizacion CABYS</field>
            <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="description">Notifica las actualizaciones diarios del codigo de Cabys en los productos.</field>
        </record>

        <!-- notify all employees of module installation -->
        <record model="mail.message" id="module_install_notification_cabys">
            <field name="model">mail.channel</field>
            <field name="res_id" ref="mail.channel_all_employees"/>
            <field name="message_type">comment</field>
            <field name="subtype_id" ref="mail.mt_comment"/>
            <field name="subject">Welcome to Odoo Cabys!</field>
            <field name="body"><![CDATA[<p>Bienvenido para la actualizacion de codigo CABYS</p>]]></field>
        </record>
    </data>
</odoo>
