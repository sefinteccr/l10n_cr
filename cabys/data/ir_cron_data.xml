<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="ir_cron_Scheduled_catalog" model="ir.cron">
            <field name="name">Cabys Scheduled Actions</field>
            <field name="model_id" ref="model_cabys_producto" />
            <field name="state">code</field>
            <field name="code">model.scheduled_catalog()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">weeks</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=6, minute=30))" />
            <field name="numbercall">-1</field>
        </record>
    </data>
</odoo>