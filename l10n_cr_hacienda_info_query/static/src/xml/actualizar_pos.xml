<?xml version="1.0" encoding="UTF-8"?>
<templates id="actualizar_pos" name="actualizar_pos" xml:space="preserve">
    <!--t t-name="CustomButton"><div class="control-button">Obtener Nombre
        </div></t-->
    <t t-extend="ClientDetailsEdit">
        <t t-jquery="input.client-name" t-operation="replace"/>
        <!--Artilugio para poder eliminar el NIF o VAT ya que compartia la misma clase con otros campos-->
        <t t-jquery="div.client-details-right" t-operation="replace">
            <div class="client-details-right">
                <div class="client-detail">
                    <span class="label">Email</span>
                    <input class="detail client-email" name="email" t-att-value="partner.email || &quot;&quot;" type="email"/>
                </div>
                <div class="client-detail">
                    <span class="label">Phone</span>
                    <input class="detail client-phone" name="phone" t-att-value="partner.phone || &quot;&quot;" type="tel"/>
                </div> 
                <div t-attf-class="client-detail ">
                    <span class="label">Actividad Económica</span>
                    <select class="detail economic-activity" name="activity_id" id="economic_activity_select">
                        <t t-if="partner.economic_activities_ids">
                            <t t-foreach="widget.pos.economic_activities" t-as="activity">
                                <t t-if="partner.economic_activities_ids.includes(activity.id)">
                                    <option t-att-selected="partner.activity_id ? (activity.id === partner.activity_id[0] ? true : undefined) : undefined"
                                            t-att-value="activity.id">
                                        <t t-esc="activity.code"/>-<t t-esc="activity.name"/>
                                    </option>
                                </t>
                            </t>
                        </t>
                        <t t-elif="!partner.economic_activities_ids">
                            <option value="">Seleccione actividad</option>
                        </t>
                    </select>
                    <div class="">
                        <button type="button" class="oe_button oe_highlight"
                                style="float: right; margin-top: -30px;"
                                onclick="consultarActividadEconomica(document.getElementById('vat') ? document.getElementById('vat').value : '')">
                            Consultar
                        </button>
                    </div>
                </div>
                <input class="detail economic-activitys-codes" hidden="hidden" name="economic_activities_ids" t-att-value="partner.economic_activities_ids || &quot;&quot;"/>

                <div class="client-detail">
                    <span class="label">Barcode</span>
                    <input class="detail barcode" name="barcode" t-att-value="partner.barcode || &quot;&quot;"/>
                </div>
                <div t-attf-class="client-detail #{widget.pos.pricelists.length &lt;= 1 ? &quot;oe_hidden&quot; : &quot;&quot;}">
                    <span class="label">Pricelist</span>
                    <select class="detail needsclick" name="property_product_pricelist">
                        <t t-as="pricelist" t-foreach="widget.pos.pricelists">
                            <option t-att-selected="partner.property_product_pricelist ? (pricelist.id === partner.property_product_pricelist[0] ? true : undefined) : undefined" t-att-value="pricelist.id">
                                <t t-esc="pricelist.display_name"/>
                            </option>
                        </t>
                    </select>
                </div>
            </div>
        </t>
        <t t-jquery="div.client-picture" t-operation="after">
            <input class="detail client-name" id="vat" name="vat" onchange="obtener_nombre(this.value)" placeholder="Cédula" t-att-value="partner.vat"/>
            <input type="number" class="detail" id="identification_id" hidden="hidden" name="identification_id"  t-att-value="ninguno"/>
        </t>
        <t t-jquery="div.client-details-box" t-operation="before">
            <div class="client-detail">
                <span class="label"/>
                <input class="detail client-address-city" name="name" placeholder="Name" t-att-value="partner.name"/>
            </div>
        </t>
    </t>
    <t t-extend="ClientDetails">
        <t t-jquery=".client-details-left" t-operation="append">
            <div class="client-detail">
                <span class="label">Actividad Económica</span>
                <t t-if="partner.activity_id">
                    <t t-foreach="widget.pos.economic_activities" t-as="activity">
                        <t t-if="activity.id === partner.activity_id[0]">
                            <span class="detail activity-id"><t t-esc="activity.code"/>-<t t-esc="activity.name"/></span>
                        </t>
                    </t>
                </t>
                <t t-if="!partner.activity_id || !partner.activity_id.length">
                    <span class="detail activity-id empty">N/A</span>
                </t>
            </div>
        </t>
    </t>

    <t t-extend="PaymentScreenWidget">
        <t t-jquery="div.js_set_customer" t-operation="after">
            <div id="economic_activity_container"
                style="margin-top:8px; font-size:14px; display:none;">
                <span style="display:block; font-weight:bold; margin-bottom:2px;">
                    Actividad Económica
                </span>
                <select class="detail economic-activity"
                        name="activity_id"
                        id="economic_activity_select"
                        style="width:100%; padding:4px; border-radius:4px; border:1px solid #ccc;">
                </select>
            </div>
        </t>
    </t>

</templates>
